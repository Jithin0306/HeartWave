{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HeartWave",
  "version": "1.0.1",
  "identifier": "com.heartwave.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HeartWave",
        "width": 1280,
        "height": 820,
        "minWidth": 1060,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#141211"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "../resources/bin/HeartWaveCam.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBRDFDM0ZDODNBNThBMDkKUldRSmlxV0QvTVBSU3NENWlJTFVsTW5zNDAzWjZKU2lsZGxLTUNTa0kwQUxJRHRWMHJPMjE3V0cK",
      "endpoints": [
        "https://github.com/Jithin0306/HeartWave/releases/latest/download/latest.json"
      ]
    }
  }
}